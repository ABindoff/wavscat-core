# Store every text file with LF in the repository and check it out with LF on
# every platform. Without this, a Windows checkout gets CRLF while a Linux or
# macOS one gets LF, and the whole tree looks modified to whoever cloned it
# second.
* text=auto eol=lf

# Binary files must never be line-ending converted. The .rds files are the
# Kymatio reference fixtures: corrupting one would not fail loudly, it would
# quietly break the parity suite.
*.rds   binary
*.rda   binary
*.RData binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.bin   binary
*.wav   binary

# Vignettes diff more usefully with the built-in markdown driver.
*.Rmd  diff=markdown
*.md   diff=markdown

# Keep generated documentation out of language statistics and collapsed in
# pull request diffs; it is regenerated by roxygen2, not hand-edited.
man/*.Rd  linguist-generated=true
NAMESPACE linguist-generated=true
